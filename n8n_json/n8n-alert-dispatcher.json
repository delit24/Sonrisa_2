    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are a news classification assistant. Analyze the following news article and return a structured JSON response.\\n\\nArticle title: {{ $('RSS Feed Read').first().json.title }}\\nArticle content: {{ $('RSS Feed Read').first().json.contentSnippet }}\\n\\nClassify into exactly ONE category:\\n- breaking_news\\n- market\\n- natural_disaster\\n- tech\\n\\nReturn ONLY valid JSON:\\n{\\n  \\\"category\\\": \\\"breaking_news\\\",\\n  \\\"summary\\\": \\\"summary here\\\",\\n  \\\"keywords\\\": [\\\"kw1\\\", \\\"kw2\\\"],\\n  \\\"is_relevant\\\": true\\n}\"\n    }]\n  }]\n}",
        "options": {}
      },
      "id": "8e176806-8314-4e64-b5ab-951fa20ea48e",
      "name": "Gemini Flash Analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3504,
        1616
      ]
    },
    {
      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst candidates = geminiResponse.candidates;\n\nif (!candidates || candidates.length === 0) {\n  throw new Error('No candidates in Gemini response');\n}\n\nconst rawText = candidates[0].content.parts[0].text;\nconst cleanText = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleanText);\n} catch (e) {\n  throw new Error('Failed to parse Gemini JSON: ' + cleanText);\n}\n\nconst rssItem = $('RSS Feed Read').item.json;\nconst feedUrl = $('Feed URL Lista').item.json.feedUrl;\n\nreturn [{\n  json: {\n    ...parsed,\n    source_url: rssItem.link,\n    source_feed: feedUrl,\n    title: rssItem.title,\n    published_at: rssItem.pubDate,\n    raw_content: rssItem.contentSnippet || rssItem.content || ''\n  }\n}];"
      },
      "id": "1275ded6-71da-4a09-b979-57b7b00b26c8",
      "name": "Parse Gemini Response",
      "type": "n8n-nodes-base.code",
