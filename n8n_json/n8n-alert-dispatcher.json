        "message": "=Hello,\n\nA new alert has been triggered based on your preferences.\n\nCategory: {{ $json.eventCategory }}\nTitle: {{ $json.eventTitle }}\n\nSummary:\n{{ $json.eventSummary }}\n\n---\nAlert System — Manage your preferences at {{ $env.WEBAPI_BASE_URL }}\nTo unsubscribe or change your preferences, log in to your account.",
        "options": {
          "allowUnauthorizedCerts": false
        }
      },
