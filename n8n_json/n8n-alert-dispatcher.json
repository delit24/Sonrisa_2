    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WEBAPI_BASE_URL }}/api/internal/user-preferences",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{ $env.WEBAPI_INTERNAL_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Get User Preferences",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "jsCode": "// Eventek és user preferenciák összegyűjtése\nconst events = $('Get Unprocessed Events').all().map(i => i.json);\nconst users = $('Get User Preferences').first().json;\n\nif (!Array.isArray(users) || users.length === 0) {\n  return [];\n}\n\nconst matches = [];\n\nfor (const event of events) {\n  for (const user of users) {\n    if (!user.preferences || !user.channels) continue;\n\n    for (const pref of user.preferences) {\n      // Kategória egyezés ellenőrzés\n      if (pref.category !== event.category) continue;\n\n      // Kulcsszó szűrés (ha van megadva)\n      if (pref.keyword) {\n        const keyword = pref.keyword.toLowerCase();\n        const inSummary = (event.summary || '').toLowerCase().includes(keyword);\n        const inKeywords = Array.isArray(event.keywords)\n          ? event.keywords.some(k => k.toLowerCase().includes(keyword))\n          : false;\n        const inTitle = (event.title || '').toLowerCase().includes(keyword);\n\n        if (!inSummary && !inKeywords && !inTitle) continue;\n      }\n\n      // Match! Minden aktív csatornára létrehozunk egy rekordot\n      for (const channel of user.channels) {\n        if (!channel.isActive) continue;\n\n        matches.push({\n          eventId: event.id,\n          userId: user.userId,\n          eventTitle: event.title,\n          eventSummary: event.summary,\n          eventCategory: event.category,\n          channel: channel.type,\n          destination: channel.destination\n        });\n      }\n    }\n  }\n}\n\nreturn matches.map(m => ({ json: m }));"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "Match Events to Users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
