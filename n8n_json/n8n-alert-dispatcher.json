        "jsCode": "// Összegyűjtjük az összes egyedi event ID-t amit feldolgoztunk\nconst allItems = $('Get Unprocessed Events').all().map(i => i.json.id);\nconst uniqueEventIds = [...new Set(allItems)];\n\nreturn uniqueEventIds.map(id => ({ json: { eventId: id } }));"
