      "id": "4111bc62-68c0-4867-b157-43483ca168c0",
      "name": "Get User Preferences",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4032,
        1920
      ]
    },
    {
      "parameters": {
        "jsCode": "const events = $('Get Unprocessed Events').all().map(i => i.json);\nconst users = $('Get User Preferences').first().json;\n\nif (!Array.isArray(users) || users.length === 0) {\n  return [];\n}\n\nconst matches = [];\n\nfor (const event of events) {\n  for (const user of users) {\n    if (!user.preferences || !user.channels) continue;\n\n    for (const pref of user.preferences) {\n      if (pref.category !== event.category) continue;\n\n      if (pref.keyword) {\n        const keyword = pref.keyword.toLowerCase();\n        const inSummary = (event.summary || '').toLowerCase().includes(keyword);\n        const inKeywords = Array.isArray(event.keywords)\n          ? event.keywords.some(k => k.toLowerCase().includes(keyword))\n          : false;\n        const inTitle = (event.title || '').toLowerCase().includes(keyword);\n\n        if (!inSummary && !inKeywords && !inTitle) continue;\n      }\n\n      for (const channel of user.channels) {\n        if (!channel.isActive) continue;\n\n        matches.push({\n          eventId: event.id,\n          userId: user.userId,\n          eventTitle: event.title,\n          eventSummary: event.summary,\n          eventCategory: event.category,\n          channel: channel.type,\n          destination: channel.destination\n        });\n      }\n    }\n  }\n}\n\nreturn matches.map(m => ({ json: m }));"
      },
